# Боевые настройки для Docker. Скопируйте в .env (он в .gitignore), заполните, передайте
# контейнеру через --env-file .env. В образ и в git .env не попадает — пароли только здесь.
# Имена переменных читает settings.py (pydantic-settings), регистр не важен.

# --- База (MariaDB/MySQL) ---
DB_HOST=192.168.100.XX          # IP сервера базы ISU
DB_PORT=3306
DB_USER=turnstile              # отдельный пользователь, см. turnstile_connector.sql
DB_PASSWORD=                    # пароль пользователя БД
DB_NAME=turnstile_db            # база коннектора (вьюхи в ней тянут источник из базы ISU)
DB_CHARSET=utf8

# --- Синхронизация карт ---
SYNC_VIEW=v_turnstile_xobgoh
DRY_RUN=true                    # ПЕРВЫЙ запуск только true: посмотреть логи, затем false
RECONCILE_AT=03:00              # ночная полная сверка карт; пусто — выкл.

# --- Вебхук ISU (его дёргает ISU после изменения списка жильцов) ---
HTTP_TOKEN=                     # длинный случайный токен, >=16 символов

# --- Проходы (события) ---
EVENTS_ENABLED=false            # включить после приёмки синхронизации карт
POLL_SECONDS=2                  # как часто опрашивать контроллеры, сек
HISTORY_ON_FIRST_START=false    # старая история уже в базе через N3000 — не дублировать
MDB_PATH=                       # файл N3000 Download (iCCard3000.mdb) для суточной сверки; пусто — выкл.

# --- API / Swagger ---
API_KEY=                        # X-API-Key для эндпоинтов записи; пусто — запись запрещена целиком
UVICORN_ROOT_PATH=/turnstile    # nginx срезает префикс /turnstile; Swagger будет на /turnstile/docs
API_BIND=0.0.0.0                # внутри контейнера слушаем все адреса; наружу публикуем только 127.0.0.1 (см. DEPLOY.md)
API_PORT=8000

# --- Лог ---
# Пусто — только stdout (как надо в Docker: логи читаются через docker logs). Файл задавать не нужно.
LOG_FILE=
